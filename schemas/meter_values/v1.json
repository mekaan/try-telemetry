{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Periodic meter reading (from OCPP MeterValues)",
  "x-owner": "@acme/charging-core",
  "x-contains-pii": false,
  "x-retention-days": 400,
  "type": "object",
  "additionalProperties": false,
  "required": ["energy_active_import_wh"],
  "properties": {
    "transaction_id": { "type": "string" },
    "energy_active_import_wh": { "type": "number", "minimum": 0 },
    "power_active_import_w": { "type": "number", "minimum": 0 },
    "current_a": { "type": "number" },
    "voltage_v": { "type": "number" },
    "soc_percent": { "type": "number", "minimum": 0, "maximum": 100 }
  }
}
